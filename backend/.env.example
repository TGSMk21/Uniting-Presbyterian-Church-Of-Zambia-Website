# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: move the admin away from /admin/ (e.g. manage-upcz)
DJANGO_ADMIN_PATH=
# Shared with the website's server; dashboard sign-in stays off until it's set
INTERNAL_API_SECRET=

# Database
# Local development (settings/local.py) reads the DB_* variables:
DB_NAME=church_erp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# Production (settings/production.py) requires DATABASE_URL instead.
# Supabase: port 5432 = session pooler, 6543 = transaction pooler (both work).
DATABASE_URL=postgresql://user:password@localhost:5432/church_erp

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# AI API (Claude or GPT)
AI_API_KEY=your-api-key
AI_API_MODEL=claude-sonnet-4-20250514

# OpenAI / Whisper
OPENAI_API_KEY=your-openai-key

# YouTube Data API
YOUTUBE_API_KEY=your-youtube-api-key
# Shared secret for POST /api/tasks/sync-youtube/ (send it as the X-Sync-Token header); empty disables the endpoint
SYNC_TOKEN=

# Media storage (Cloudflare R2), production only; leave AWS_STORAGE_BUCKET_NAME
# empty locally to keep uploads on disk. See README "Storing uploads".
AWS_STORAGE_BUCKET_NAME=
AWS_PRIVATE_BUCKET_NAME=
MEDIA_PUBLIC_DOMAIN=pub-xxxx.r2.dev
AWS_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# Payment gateway (Flutterwave / MTN MoMo)
FLUTTERWAVE_SECRET_KEY=your-flutterwave-key
MTN_MOMO_API_KEY=your-mtn-momo-key
MTN_MOMO_ENVIRONMENT=sandbox

# Frontend origin(s) allowed by CORS; comma-separate several in production
# (e.g. https://upcz.org,https://www.upcz.org)
FRONTEND_URL=http://localhost:3000

# Production only: extra origins trusted for CSRF (e.g. the admin's own https:// URL)
CSRF_TRUSTED_ORIGINS=
