# Django backend API base URL, including the /api suffix
NEXT_PUBLIC_API_URL=http://localhost:8000/api


# Shared with the backend's INTERNAL_API_SECRET; dashboard sign-in stays off until both are set
INTERNAL_API_SECRET=

# Resend (contact form email)
RESEND_API_KEY=your-resend-api-key
# Sender on a domain verified in Resend (the default sandbox sender only reaches the Resend account owner)
RESEND_FROM_EMAIL=Church Website <website@your-verified-domain.org>
# Recipient for the national /contact page (branch pages use each branch's contact_email)
NATIONAL_CONTACT_EMAIL=office@your-domain.org

# Upstash Redis (contact form rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
